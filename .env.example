# Copy this file to .env.local and adjust the values for your machine.
# Never commit real credentials. .env.local is ignored by Git.

# Symfony
APP_ENV=dev
APP_SECRET=change-me
DEFAULT_URI=http://localhost:8081

# PostgreSQL (host connection used by PHP when it runs outside Docker).
# Keep the password in sync with POSTGRES_PASSWORD below.
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/bibliotheque?serverVersion=16&charset=utf8

# Docker Compose
POSTGRES_DB=bibliotheque
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_VERSION=16
POSTGRES_PORT=5432
HTTP_PORT=8081
MAILPIT_HTTP_PORT=8026

# Mailer
MAILER_DSN=null://null

# Messenger
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Gemini (agent IA) — ne jamais mettre la vraie clé ici.
# Stockez-la dans le coffre Symfony : php bin/console secrets:set GEMINI_API_KEY
GEMINI_API_KEY=

# Agent LLM compatible OpenAI (ne jamais mettre de vraie clé ou URL de tunnel ici ; utiliser .env.local)
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
