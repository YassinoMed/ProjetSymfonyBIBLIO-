{% extends 'base.html.twig' %}
{% import 'components/icon.html.twig' as ui %}

{% block body_class %}page app-page{% endblock %}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}
{% block main_class %}app-main{% endblock %}

{% block body %}
    <div class="app-layout">
        {% include 'partials/app-sidebar.html.twig' %}
        <div class="app-shell">
            <header class="app-topbar">
                <div class="app-topbar__context">
                    <button class="app-topbar__menu" type="button" data-sidebar-open aria-controls="app-sidebar" aria-label="Ouvrir le menu">
                        {{ ui.icon('menu') }}
                    </button>
                    <span>La Bibliothèque</span>
                    <span aria-hidden="true">/</span>
                    <strong>{{ roleLabel }}</strong>
                </div>
                <div class="app-topbar__actions">
                    <button class="icon-button" type="button" data-notification-button aria-label="Afficher les notifications">
                        {{ ui.icon('bell') }}
                        <span class="notification-dot" aria-hidden="true"></span>
                    </button>
                    <span class="avatar avatar--small" aria-hidden="true">
                        {% if role == 'admin' %}AM{% elseif role == 'librarian' %}AB{% else %}YN{% endif %}
                    </span>
                </div>
            </header>
            <div class="app-content">
                {% block dashboard %}{% endblock %}
            </div>
        </div>
    </div>
{% endblock %}
