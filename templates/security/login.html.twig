{% extends 'base.html.twig' %}

{% block title %}Connexion — Bibliothèque{% endblock %}

{% block body %}
    <section class="auth">
        <div class="card">
            <p class="eyebrow">Espace personnel</p>
            <h1>Connexion</h1>
            <p class="muted">Accédez à vos emprunts, réservations et outils de gestion.</p>

            {% if error %}
                <div class="alert alert--error" role="alert">Identifiants invalides.</div>
            {% endif %}

            <form method="post" class="form">
                <label for="username">Adresse e-mail</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required autofocus>

                <label for="password">Mot de passe</label>
                <input type="password" name="_password" id="password" autocomplete="current-password" required>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="button">Se connecter</button>
            </form>
        </div>
    </section>
{% endblock %}
