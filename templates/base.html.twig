<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Bibliothèque{% endblock %}</title>
        <meta name="description" content="{% block description %}Bibliothèque — gestion des prêts, réservations et du catalogue.{% endblock %}">
        <link rel="stylesheet" href="{{ asset('build/app.css') }}">
        <script type="module" src="{{ asset('build/app.js') }}"></script>
    </head>
    <body class="{% block body_class %}page{% endblock %}">
        {% block header %}
            {% include 'partials/site-header.html.twig' %}
        {% endblock %}

        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert--{{ type }}" role="status">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <main class="{% block main_class %}site-main{% endblock %}">
            {% block body %}{% endblock %}
        </main>

        {% block footer %}
            {% include 'partials/site-footer.html.twig' %}
        {% endblock %}
    </body>
</html>
