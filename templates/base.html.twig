<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Bibliothèque{% endblock %}</title>
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    </head>
    <body>
        <header class="site-header">
            <a class="brand" href="{{ path('app_login') }}">Bibliothèque</a>
            <nav class="site-nav">
                {% if app.user %}
                    <span class="user-email">{{ app.user.userIdentifier }}</span>
                    <form method="post" action="{{ path('app_logout') }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit" class="link-button">Se déconnecter</button>
                    </form>
                {% else %}
                    <a href="{{ path('app_login') }}">Connexion</a>
                {% endif %}
            </nav>
        </header>

        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert--{{ type }}" role="status">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <main class="site-main">
            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            <p>Bibliothèque — gestion des prêts, réservations et du catalogue.</p>
        </footer>
    </body>
</html>
