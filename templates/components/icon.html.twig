{% macro icon(name, className = '') %}
<svg class="icon {{ className }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {% if name == 'search' %}
        <circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path>
    {% elseif name == 'arrow-right' %}
        <path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>
    {% elseif name == 'arrow-up-right' %}
        <path d="M7 17 17 7"></path><path d="M7 7h10v10"></path>
    {% elseif name == 'book' %}
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"></path>
