        <path d="m12 3-1.1 3.4A3 3 0 0 1 8.8 8.5L5.5 9.5l3.3 1.1a3 3 0 0 1 2.1 2.1L12 16l1.1-3.3a3 3 0 0 1 2.1-2.1l3.3-1.1-3.3-1a3 3 0 0 1-2.1-2.1L12 3Z"></path><path d="m5 3-.4 1.2A2 2 0 0 1 3.4 5.4L2.5 6l.9.6a2 2 0 0 1 1.2 1.2L5 9l.4-1.2a2 2 0 0 1 1.2-1.2l.9-.6-.9-.6a2 2 0 0 1-1.2-1.2L5 3Z"></path>
    {% elseif name == 'user' %}
        <circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path>
    {% elseif name == 'users' %}
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.9"></path><path d="M16 3.1a4 4 0 0 1 0 7.8"></path>
    {% elseif name == 'clock' %}
        <circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>
    {% elseif name == 'calendar' %}
        <rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path>
    {% elseif name == 'library' %}
        <path d="m16 6 4 14"></path><path d="M12 6v14"></path><path d="M8 8v12"></path><path d="M4 4v16"></path>
    {% elseif name == 'settings' %}
