    {% elseif name == 'home' %}
        <path d="m3 11 9-8 9 8"></path><path d="M5 10v10h14V10"></path><path d="M9 20v-6h6v6"></path>
    {% elseif name == 'rotate' %}
        <path d="M20 11a8 8 0 1 0-2.3 5.7"></path><path d="M20 4v7h-7"></path>
    {% elseif name == 'logout' %}
        <path d="M10 17l5-5-5-5"></path><path d="M15 12H3"></path><path d="M14 3h5a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-5"></path>
    {% elseif name == 'shield' %}
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"></path><path d="m9 12 2 2 4-4"></path>
    {% elseif name == 'audit' %}
        <path d="M9 5h10M9 9h10M9 13h6"></path><path d="M5 3h2v18H3V5a2 2 0 0 1 2-2Z"></path><path d="m14 17 2 2 4-4"></path>
    {% elseif name == 'trend' %}
        <path d="m3 17 6-6 4 4 8-9"></path><path d="M15 6h6v6"></path>
    {% elseif name == 'plus' %}
        <path d="M12 5v14M5 12h14"></path>
    {% elseif name == 'more' %}
        <circle cx="5" cy="12" r="1"></circle><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle>
    {% elseif name == 'eye' %}
        <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"></path><circle cx="12" cy="12" r="2.5"></circle>
    {% elseif name == 'alert' %}
