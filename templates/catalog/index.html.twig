{% extends 'base.html.twig' %}
{% import 'components/icon.html.twig' as ui %}

{% block title %}Catalogue — La Bibliothèque{% endblock %}
{% block description %}Explorez le catalogue de La Bibliothèque et filtrez par thème ou disponibilité.{% endblock %}

{% block body %}
<section class="page-hero page-hero--catalog">
    <div class="container page-hero__grid">
        <div>
            <p class="eyebrow"><span class="eyebrow__dot"></span> Catalogue vivant</p>
            <h1>Le catalogue</h1>
            <p>Huit ouvrages de démonstration pour explorer une recherche, une disponibilité et une fiche détaillée.</p>
        </div>
        <form class="catalog-search" action="{{ path('app_catalog') }}" method="get" role="search" data-catalog-form>
            <label class="sr-only" for="catalog-search-input">Rechercher dans le catalogue</label>
            {{ ui.icon('search') }}
            <input id="catalog-search-input" type="search" name="q" value="{{ query }}" placeholder="Titre, auteur, sujet…" autocomplete="off" data-catalog-search>
            <input type="hidden" name="category" value="{{ selectedCategory }}" data-catalog-hidden-category>
            <input type="hidden" name="status" value="{{ selectedStatus }}" data-catalog-hidden-status>
            <input type="hidden" name="sort" value="{{ selectedSort }}" data-catalog-hidden-sort>
            <button class="button button--primary" type="submit">Rechercher</button>
        </form>
    </div>
</section>

<section class="section section--topless">
    <div class="container">
        <div class="catalog-toolbar">
            <p class="catalog-toolbar__count" data-catalog-count aria-live="polite">
                <strong>{{ books|length }}</strong>
                <span>{{ books|length == 1 ? 'ouvrage trouvé' : 'ouvrages trouvés' }}</span>
            </p>
            <div class="catalog-toolbar__filters">
                <label class="catalog-toolbar__label" for="catalog-category">{{ ui.icon('filter') }} Thème</label>
                <select class="select-field" id="catalog-category" name="category" data-catalog-filter>
                    <option value="">Tous les thèmes</option>
                    {% for item in categories %}
                        <option value="{{ item }}" {{ selectedCategory == item ? 'selected' : '' }}>{{ item }}</option>
                    {% endfor %}
                </select>
                <label class="sr-only" for="catalog-status">Disponibilité</label>
                <select class="select-field" id="catalog-status" name="status" data-catalog-filter>
                    <option value="">Toutes les disponibilités</option>
                    <option value="available" {{ selectedStatus == 'available' ? 'selected' : '' }}>Disponible</option>
                    <option value="loan" {{ selectedStatus == 'loan' ? 'selected' : '' }}>Emprunté</option>
                    <option value="reserved" {{ selectedStatus == 'reserved' ? 'selected' : '' }}>Réservé</option>
                    <option value="repair" {{ selectedStatus == 'repair' ? 'selected' : '' }}>En réparation</option>
                </select>
                <label class="sr-only" for="catalog-sort">Trier les résultats</label>
                <select class="select-field" id="catalog-sort" name="sort" data-catalog-sort>
                    <option value="title" {{ selectedSort == 'title' ? 'selected' : '' }}>Titre A–Z</option>
                    <option value="year" {{ selectedSort == 'year' ? 'selected' : '' }}>Plus récents</option>
                    <option value="availability" {{ selectedSort == 'availability' ? 'selected' : '' }}>Disponibilité</option>
                </select>
                <a class="text-link text-link--small" href="{{ path('app_catalog') }}" data-catalog-reset>Réinitialiser</a>
            </div>
        </div>

        <div class="catalog-grid" data-catalog-grid aria-live="polite">
            {% for book in books %}
                <article class="catalog-card" data-book-card data-title="{{ book.title }}" data-author="{{ book.author }}" data-category="{{ book.category }}" data-status="{{ book.status }}" data-status-label="{{ book.statusLabel }}" data-year="{{ book.year }}" data-copies="{{ book.copies }}" data-accent="{{ book.accent }}" data-summary="{{ book.summary }}" data-isbn="{{ book.isbn }}">
                    <button class="catalog-card__cover" type="button" data-book-open aria-label="Voir la fiche de {{ book.title }}">
                        <span class="book-cover book-cover--{{ book.accent }}">
                            <span class="book-cover__eyebrow">{{ book.category }}</span>
                            <strong>{{ book.title }}</strong>
                            <small>{{ book.author }} · {{ book.year }}</small>
                            <i aria-hidden="true"></i>
                        </span>
                    </button>
                    <div class="catalog-card__meta">
                        <h2>{{ book.title }}</h2>
                        <p>{{ book.author }} · {{ book.year }}</p>
                        <span class="availability availability--{{ book.status }}">
                            <i></i>{{ book.statusLabel }} · {{ book.copies }} exemplaire{{ book.copies > 1 ? 's' : '' }}
                        </span>
                    </div>
                </article>
            {% endfor %}
        </div>

        <div class="empty-state" data-catalog-empty {% if books is not empty %}hidden{% endif %}>
            {{ ui.icon('search') }}
            <h2>Aucun ouvrage ne correspond</h2>
            <p>Essayez un autre titre, un autre auteur ou élargissez les filtres pour retrouver votre prochaine lecture.</p>
            <a class="button button--primary" href="{{ path('app_catalog') }}">Voir tout le catalogue</a>
        </div>
    </div>
</section>

<dialog data-book-dialog aria-labelledby="book-dialog-title">
    <div class="book-dialog__panel">
        <button class="icon-button book-dialog__close" type="button" data-dialog-close aria-label="Fermer la fiche">{{ ui.icon('x') }}</button>
        <div class="book-dialog__cover">
            <span class="book-cover" data-dialog-cover>
                <span class="book-cover__eyebrow" data-dialog-category></span>
                <strong data-dialog-title id="book-dialog-title"></strong>
                <small data-dialog-author></small>
                <i aria-hidden="true"></i>
            </span>
        </div>
        <div class="book-dialog__content">
            <p class="eyebrow">Fiche de l’ouvrage</p>
            <div class="book-dialog__meta">
                <span data-dialog-year></span>
                <span aria-hidden="true">·</span>
                <span data-dialog-isbn></span>
            </div>
            <p class="muted" data-dialog-summary></p>
            <div class="book-dialog__availability">
                <span class="status-dot" data-dialog-status></span>
                <strong data-dialog-copies></strong>
            </div>
            <div class="book-dialog__actions">
                {% if app.user %}
                    <button class="button button--primary" type="button" data-dialog-borrow>Emprunter</button>
                {% else %}
                    <a class="button button--primary" href="{{ path('app_login') }}">Se connecter pour emprunter</a>
                {% endif %}
                <button class="button" type="button" data-dialog-close>Fermer</button>
            </div>
        </div>
    </div>
</dialog>
{% endblock %}
